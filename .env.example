# --- Node Environment ---
NODE_ENV="development"
PORT=5001
LOG_LEVEL="info"

# --- Database (MongoDB) ---
DATABASE_URL="mongodb://localhost:27017/ecommers"
TEST_DATABASE_URL="mongodb://localhost:27017/ecommers_test"

# --- Redis ---
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# REDIS_PASSWORD=""
ENABLE_QUEUES="true"

# --- Authentication & JWT ---
JWT_ACCESS_SECRET="8f4c2d9a7e1b6c3f0a5d8e2b9c7f1a4d6e8b3c0f5a9d2e7c1b6f8a3d0e5c9b2"
JWT_REFRESH_SECRET="3c7a1e9f5b2d8c4a6e0f3b7d9a1c5e8f2b6d4c0a9e7f1b3d5c8a6e2f9b4c7"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Default Admin Seed ---
DEFAULT_SUPERADMIN_EMAIL="superadmin@gmail.com"
DEFAULT_SUPERADMIN_PASSWORD="admin@123"

# --- CORS & URLs ---
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:5001/api/v1"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"

# --- Third-party Services ---
PAYMENT_WEBHOOK_SECRET="whsec_mock_local_secret_for_tests"
GOOGLE_CLIENT_ID="mock-google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="mock-google-client-id.apps.googleusercontent.com"
